# Copy to backend/.env for local development. Never commit real secrets.
MATT_ENV=development
MATT_DATABASE_URL=sqlite:///./matt.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/matt
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATT_SECRET_KEY=change-me
MATT_ACCESS_TOKEN_MINUTES=60
MATT_CORS_ORIGINS=["http://localhost:5173"]
MATT_LOG_LEVEL=INFO
MATT_LOG_JSON=true
MATT_LOGIN_RATE_LIMIT=10
MATT_LOGIN_RATE_WINDOW_SECONDS=60
