# Copy to backend/.env for local development. Never commit real secrets.
MATT_ENV=development
MATT_DATABASE_URL=sqlite:///./matt.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/matt
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATT_SECRET_KEY=change-me
MATT_ACCESS_TOKEN_MINUTES=60
MATT_CORS_ORIGINS=["http://localhost:5173"]
MATT_LOG_LEVEL=INFO
MATT_LOG_JSON=true
MATT_LOGIN_RATE_LIMIT=10
MATT_LOGIN_RATE_WINDOW_SECONDS=60
# Optional: "Sign in with Google" (see docs/deployment.md)
MATT_GOOGLE_CLIENT_ID=
MATT_OWNER_EMAIL=
# AI models, cheapest first. Set at least one. Keys stay in the environment, never in git.
MATT_GEMINI_API_KEY=
MATT_GEMINI_MODEL=gemini-2.5-flash
MATT_GROQ_API_KEY=
MATT_OLLAMA_URL=
MATT_ANTHROPIC_API_KEY=
# Premium (Claude) models also need this opt-in.
MATT_ALLOW_PREMIUM_MODELS=false
# Spending limits for paid models, in rupees. 0 = paid models never run without your approval.
MATT_DAILY_AI_BUDGET_INR=0
MATT_MONTHLY_AI_BUDGET_INR=0
MATT_USD_TO_INR=84
# Background worker that runs queued tasks inside the web process.
MATT_WORKER_ENABLED=true
